rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // LECTURA PÚBLICA PARA TODOS LOS MIEMBROS (Modo Consulta)
    // Cualquier usuario puede consultar las builds, roster oficial y contenidos del gremio
    match /builds/{buildId} {
      allow read: if true;
      allow write: if false; // Requiere servidor o autenticación
    }

    match /roster/{memberId} {
      allow read: if true;
      allow write: if false;
    }

    match /activities/{activityId} {
      allow read: if true;
      allow write: if false;
    }

    match /contents/{contentId} {
      allow read: if true;
      allow write: if false;
    }

    match /config/{configDoc} {
      allow read: if true;
      allow write: if false;
    }

    // Por defecto, denegar todo lo demás
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
